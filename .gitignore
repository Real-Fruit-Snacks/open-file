# Dependencies
node_modules/

# Build output (source maps are moved out of dist/ by scripts/postbuild.mjs)
dist/
dev-dist/
sourcemaps/
coverage/
*.tsbuildinfo

# Engine binaries are downloaded by `npm run engine:setup` (see public/engine/README.md)
public/engine/*
!public/engine/README.md

# The human-like opponent's model and runtime are installed by `npm run maia:setup`
public/maia/*
!public/maia/README.md

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# Local env files
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Lighthouse report written by `npm run lighthouse -- --json`
lighthouse.json

# The sync relay: Wrangler's working folder, local secrets, and a self-hosted relay's database
.wrangler/
.dev.vars*
relay.db*

# The offline copy and its zip, made by `npm run release:offline`
release/

# An unzipped dev kit's own files: its npm cache, engine, model and browser (scripts/build-dev-kit.mjs)
/offline/
